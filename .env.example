# Shared backend/bot security. Use a long random value in real deployments.
PNN_SHARED_SECRET=change-me-to-a-long-random-secret
INTERNAL_API_KEY=change-me-to-a-long-random-secret

# Backend
DATABASE_PATH=data/pnn.sqlite3
NEWS_SCORE_THRESHOLD=65
AI_CONFIDENCE_THRESHOLD=60
ANALYSIS_WINDOW_MINUTES=10
MIN_RELATED_MESSAGES=2
FORCE_DRAFTS=false
BOT_REVIEW_ENDPOINT=
PNN_BOT_CALLBACK_URL=
AI_DRAFTS_ENABLED=false
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Discord bot
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
PNN_REVIEW_CHANNEL_ID=
PNN_NEWS_CHANNEL_ID=
PNN_EDITOR_ROLE_ID=
PNN_TIME_ZONE=Europe/Warsaw
PORT=3000
